ENV=development
DATABASE_URL=postgres://user:pass@localhost:5432/dbname?sslmode=disable
HTTP_ADDR=:8080
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_API_KEY_HERE
DEFAULT_TIMEZONE=America/New_York
PARSER=regex
ANTHROPIC_API_KEY=

# Memory layer
CHAT_VERBATIM_TURNS=20        # how many recent turns to keep verbatim (rest folded into summary)
SUMMARIZE_INTERVAL=5m         # how often the summarize loop runs (e.g. 5m, 30m, 1h)